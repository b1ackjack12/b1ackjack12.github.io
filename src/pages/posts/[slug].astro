---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { SERIES_BY_SLUG, byDate } from '../../data/series';
export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.data.slug ?? p.id }, props: { post: p, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p) => `${base}/posts/${p.data.slug ?? p.id}/`;
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Chronological order (date, then folder name for same-day posts).
const chrono = [...all].sort(byDate);

// Series membership: prev/next walk the series; posts outside a series walk the whole blog.
const seriesMeta = post.data.series ? SERIES_BY_SLUG[post.data.series] : undefined;
const seriesPosts = seriesMeta ? chrono.filter((p) => p.data.series === post.data.series) : chrono;
const pos = seriesPosts.findIndex((p) => p.id === post.id);
const prev = pos > 0 ? seriesPosts[pos - 1] : undefined;
const next = pos >= 0 && pos < seriesPosts.length - 1 ? seriesPosts[pos + 1] : undefined;

// Related: shared tags weigh most, same series next, then recency; never the prev/next already shown.
const tags = new Set(post.data.tags || []);
const related = all
  .filter((p) => p.id !== post.id && p.id !== prev?.id && p.id !== next?.id)
  .map((p) => {
    const shared = (p.data.tags || []).filter((t) => tags.has(t)).length;
    const sameSeries = post.data.series && p.data.series === post.data.series ? 1 : 0;
    return { p, score: shared * 10 + sameSeries * 5, when: p.data.date.valueOf() };
  })
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.when - a.when)
  .slice(0, 3)
  .map((r) => r.p);
---
<Layout title={post.data.title} description={post.data.description} seoTitle={post.data.seoTitle} seoDescription={post.data.seoDescription} image={post.data.thumbnail?.src} article={true} tags={post.data.tags} date={post.data.date} author={post.data.author}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    {post.data.thumbnail && <Image src={post.data.thumbnail} alt={post.data.title} class="w-full rounded-lg mb-8" />}
    <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">{post.data.title}</h1>
    <div class="text-gray-500 dark:text-gray-400 mb-6">
      {fmt(post.data.date)} &middot; {post.data.author}
    </div>
    {post.data.tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {post.data.tags.map((t) => <span class="px-3 py-1 text-sm rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300">#{t}</span>)}
      </div>
    )}
    {seriesMeta && (
      <aside class="mb-8 rounded-lg border border-blue-200 dark:border-blue-900 bg-blue-50 dark:bg-blue-950/40 px-5 py-4 text-sm text-gray-700 dark:text-gray-300">
        <span class="font-semibold text-gray-900 dark:text-gray-100">Part {pos + 1} of {seriesPosts.length}</span> in the series
        <a href={`${base}/series/${seriesMeta.slug}/`} class="font-semibold text-blue-700 dark:text-blue-300 hover:underline">{seriesMeta.title}</a>.
        {prev && <span> Previous: <a href={href(prev)} class="text-blue-700 dark:text-blue-300 hover:underline">{prev.data.seoTitle ?? prev.data.title}</a>.</span>}
      </aside>
    )}
    <div class="prose max-w-none text-gray-800 dark:text-gray-200"><Content /></div>

    {(prev || next) && (
      <nav class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="Series navigation">
        <div>
          {prev && (
            <a href={href(prev)} class="block h-full rounded-lg border border-gray-200 dark:border-gray-700 p-4 no-underline hover:border-blue-400 dark:hover:border-blue-500 transition-colors">
              <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">&larr; Previous{seriesMeta ? ' in series' : ''}</div>
              <div class="font-semibold text-gray-900 dark:text-gray-100">{prev.data.seoTitle ?? prev.data.title}</div>
              <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">{fmt(prev.data.date)}</div>
            </a>
          )}
        </div>
        <div>
          {next && (
            <a href={href(next)} class="block h-full rounded-lg border border-gray-200 dark:border-gray-700 p-4 no-underline hover:border-blue-400 dark:hover:border-blue-500 transition-colors sm:text-right">
              <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Next{seriesMeta ? ' in series' : ''} &rarr;</div>
              <div class="font-semibold text-gray-900 dark:text-gray-100">{next.data.seoTitle ?? next.data.title}</div>
              <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">{fmt(next.data.date)}</div>
            </a>
          )}
        </div>
      </nav>
    )}
    {seriesMeta && (
      <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
        All {seriesPosts.length} posts in <a href={`${base}/series/${seriesMeta.slug}/`} class="text-blue-600 dark:text-blue-400 hover:underline">{seriesMeta.title}</a>, in order.
      </p>
    )}

    {related.length > 0 && (
      <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700">
        <h3 class="text-xl font-bold mb-4 text-gray-900 dark:text-gray-100">Related posts</h3>
        <ul class="space-y-3">
          {related.map((p) => (
            <li>
              <a href={href(p)} class="text-blue-600 dark:text-blue-400 hover:underline font-medium">{p.data.seoTitle ?? p.data.title}</a>
              {p.data.seoDescription && <div class="text-sm text-gray-600 dark:text-gray-400">{p.data.seoDescription}</div>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Layout>
